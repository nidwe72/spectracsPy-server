# Spectracs server config — PayPal payment (SANDBOX) — TEMPLATE / documentation.
#
# The REAL secrets live OUTSIDE every repo, in the un-versioned folder
#   ../spectracsPy-server-config/.env
# (override the folder with the SPECTRACS_SERVER_CONFIG_DIR env var). This committed file only
# documents the key list — never put real values here. See SPEC_paypal_payment.md §4.4 / §4.4a.
#
# Only the RECIPIENT side + REST-app credentials go here. The PAYER (buyer) is never configured —
# the end user approves in their own PayPal in the browser.

PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Recipient = your sandbox BUSINESS account (use email OR merchant id).
PAYPAL_PAYEE_EMAIL=
PAYPAL_PAYEE_MERCHANT_ID=

# Fixed test charge (server-authoritative). 100 = 1,00 €.
PAYPAL_CURRENCY=EUR
PAYPAL_AMOUNT_MINOR=100

# Required by Orders v2; placeholder pages are fine (we capture via polling, not the redirect).
PAYPAL_RETURN_URL=https://example.com/paypal/return
PAYPAL_CANCEL_URL=https://example.com/paypal/cancel
